# Image published by GitHub Actions. Leave the tag as latest.
IMAGE=ghcr.io/almouj-smart-solutions/portfolio-site-desktop:latest

# Host Caddy should proxy this port. Do not enable the compose "proxy" profile on the shared VPS.
WEB_PORT=8084
# Give the app a bit more room on the shared 1GB VPS (leave headroom for waqaa/atad/caddy).
WEB_MEM_LIMIT=384m
WEB_CPUS=0.75
NODE_OPTIONS=--max-old-space-size=256

# Kept for older compose files. Hostnames are set in the Caddyfile.
SITE_DOMAIN=p.mouj.om

DATABASE_URL=file:/data/portfolio.db
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-password

# One-time only: set to 1, recreate the container to push seed content into the live DB,
# then remove it so later admin edits are not overwritten on restart.
# SEED_FORCE=1
